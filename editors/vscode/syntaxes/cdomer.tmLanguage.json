{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CDOMER",
  "scopeName": "source.cdomer",
  "fileTypes": ["cdo"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#function-declaration" },
    { "include": "#struct-declaration" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cdomer",
          "match": "//.*$"
        },
        {
          "name": "comment.block.cdomer",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cdomer",
          "match": "\\b(if|else|while|for|return|break|continue)\\b"
        },
        {
          "name": "keyword.other.cdomer",
          "match": "\\b(let|fn|struct|print)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.cdomer",
          "match": "\\b(int|float|bool|string|void)\\b"
        },
        {
          "name": "support.type.cdomer",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.cdomer",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.cdomer",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cdomer",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.cdomer",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.cdomer",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "function-declaration": {
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.cdomer" },
        "2": { "name": "entity.name.function.cdomer" }
      }
    },
    "struct-declaration": {
      "match": "\\b(struct)\\s+([A-Za-z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.cdomer" },
        "2": { "name": "entity.name.type.struct.cdomer" }
      }
    },
    "function-call": {
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.cdomer" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.cdomer",
          "match": "(\\+=|-=|\\*=|/=|=)"
        },
        {
          "name": "keyword.operator.comparison.cdomer",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.cdomer",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.cdomer",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.arrow.cdomer",
          "match": "->"
        }
      ]
    }
  }
}
