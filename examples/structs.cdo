struct Ponto {
    x: int,
    y: int
}

fn distancia2(a: Ponto, b: Ponto) -> int {
    let dx = a.x - b.x;
    let dy = a.y - b.y;
    return dx * dx + dy * dy;
}

fn main() {
    let p1 = Ponto { x: 0, y: 0 };
    let p2 = Ponto { x: 3, y: 4 };
    let d = distancia2(p1, p2);
    print("distancia ao quadrado =", d);
}
